/* vyraxis.qss */

/* gcodegraphics background colors - read by handler file 
   gradient_color1 = (0.1, 0.13, 0.17)
   gradient_color2 = (0.09, 0.11, 0.15)
*/

/** Checkboxes **/
QCheckBox {
  background: transparent;
  spacing: 10px;
  margin-bottom: 2px;
  font: 10pt "Lato";
  color: #c5cfdb;
}

QCheckBox:disabled {
  color: #59667a;
}

QCheckBox::indicator, QGroupBox::indicator {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0a0e13, stop:1 #0e131a);
  border: 1px solid #4b5c70; border-radius: 3px;
  width: 16px;
  height: 16px;
}

QCheckBox::indicator:checked, QGroupBox::indicator:checked {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #5b86a8, stop:1 #3f6584);
  border-color: #7fa6c4;
}

/** Comboboxes **/
QComboBox {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0a0e13, stop:1 #0e131a);
  color: #d3dce6;
  border: 1px solid #2e3947;
  border-radius: 4px;
  padding: 1px 0px 1px 8px;
  font: 10pt "Lato";
}

QComboBox::drop-down {
  subcontrol-origin: margin;
  subcontrol-position: top right;
  border: none;
  width: 30px;
}

QComboBox QAbstractItemView {
  background: #10151c;
  border: 1px solid #4b5c70;
  selection-background-color: #2f4a60;
  selection-color: #f2f6fa;
  padding: 2px;
  outline: 0;
}
/*QComboBox::item {
  background-color: #303030;
  color: white;
}
*/
QComboBox::item:selected {
  border: 1px solid #8cc1e6;
  color: #f2f6fa;
}

QComboBox::down-arrow {
  image: url("vyraxis/style_rc/arrow_down.png");
  height: 16px;
  width: 16px;
}

/** Dialogs **/
QDialog QPushButton {
  width: 100px;
  height: 50px;
}

/** Groupboxes **/
QGroupBox {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1b222c, stop:1 #161c25);
  border: 1px solid #2b3644;
  border-radius: 4px;
  margin-top: 1ex;
  font: 10pt "Lato Heavy";
}

QGroupBox::Title {
  subcontrol-origin: margin;
  subcontrol-position: top-center;
  padding: 0 4px;
  color: #9cc0dc;
}

/** Labels **/
QLabel {
  background: transparent;
  font: 10pt "Lato";
  color: #d3dce6;
}

DROLabel {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0a0e13, stop:1 #0e131a);
  border: 1px solid #2e3947;
  border-radius: 4px;
  font: 20pt "Lato Heavy";
  color: #00AAFF;
}

DROLabel[isHomed=false] {
  color: #FF0000;
}

QStatusBar {
  background: #0e131a;
  color: #9fb0c2;
}

/** LineEdits **/
QLineEdit, QSpinBox, StatusLabel {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0a0e13, stop:1 #0e131a);
  color: #d3dce6;
  border: 1px solid #2e3947;
  border-radius: 3px;
  font: 10pt "Lato";
}

QLineEdit:focus {
  border-color: #4a7394;
}

/** SpinBoxes **/
QSpinBox::up-button {
  subcontrol-origin: border;
  subcontrol-position: top right;
  width: 20px;
  background-color: transparent;
  border-left: 1px solid gray;
}

QSpinBox::down-button {
  subcontrol-origin: border;
  subcontrol-position: bottom right;
  width: 20px;
  background-color: transparent;
  border-left: 1px solid gray;
}

QSpinBox::up-arrow {
  image: url("vyraxis/style_rc/arrow_up.png");
  width: 16px;
  height: 16px;
}

QSpinBox::down-arrow {
  image: url("vyraxis/style_rc/arrow_down.png");
  width: 16px;
  height: 16px;
}

/** Listviews **/
QAbstractItemView {
  background: #0e131a;
  alternate-background-color: #121821;
  color: #c5cfdb;
  border: 1px solid #2b3644;
  border-radius: 3px;
  gridline-color: #1f2833;
  selection-background-color: #2f4a60;
  selection-color: #f2f6fa;
  qproperty-alternatingRowColors: false;
}

QAbstractItemView::item { border: none; }
QAbstractItemView::item:hover { background: #1c2733; }
QAbstractItemView::item:selected { background: #2f4a60; color: #f2f6fa; }

QHeaderView::section {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #232d3a, stop:1 #1b232e);
  color: #9fb0c2;
  border: none;
  font: 12pt "Lato Heavy";
}

QTableCornerButton::section { background: #1b232e; border: none; }

/** Main Window **/
QMainWindow, QDialog {
  background: qradialgradient(cx:0.5, cy:0.0, radius:1.3, fx:0.5, fy:0.0, stop:0 #1b2330, stop:0.6 #141a22, stop:1 #10151c);
}

/** Menus **/
QMenu {
  background: #10151c;
  border: 1px solid #4b5c70;
  color: #c5cfdb;
}

QMenuBar {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1a212b, stop:1 #141a22);
  border: 1px solid #2b3644;
}

QMenuBar::item { padding: 6px 12px; background: transparent; }
QMenuBar::item:selected { background: #2a3a4b; color: #f2f6fa; }
QMenuBar::item:pressed  { background: #35546f; }

QMenu::item { padding: 6px 28px 6px 20px; border-radius: 2px; }
QMenu::item:selected { background: #2f4a60; color: #f2f6fa; }
QMenu::item:disabled { color: #59667a; }
QMenu::separator { height: 1px; background: #2b3644; margin: 4px 8px; }

/** Plain Text Edit **/
QTextEdit, QPlainTextEdit {
  background: #0a0e13;
  color: #c5cfdb;
  border: 1px solid #2b3644;
  border-radius: 3px;
  selection-background-color: #3b5c78;
  padding: 4px;
 }
QTextEdit:focus, QPlainTextEdit:focus { border-color: #4a7394; }

/** Progress Bar **/
QProgressBar {
    background: #0c1016;
    border: 1px solid #2b3644;
    border-radius: 3px;
    text-align: center;
    color: #e6edf4;
    min-height: 16px;
}
QProgressBar::chunk {
    border-radius: 2px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #35546f, stop:1 #7fa6c4);
}

StatusAdjustmentBar QToolButton {
  width: 40px;
  height: 40px;
}

/** PushButtons **/
QToolButton, QPushButton {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2b3644, stop:1 #212a36);
  color: #c5cfdb;
  border: 1px solid #384555;
  border-radius: 3px;
  font: 10pt "Lato";
}

QPushButton:hover, QToolButton:hover, QTabBar::tab:hover {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #344255, stop:1 #28323f);
  border-color: #5b86a8;
  color: #e6edf4;
}

QPushButton:disabled, QPushButton:checked:disabled {
  background: #181e26;
  border-color: #252e3a;
  color: #59667a;
}

QPushButton:pressed, QPushButton:checked, QToolButton:checked, QTabBar::tab:selected {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #46698a, stop:1 #35546f);
  border-color: #7fa6c4;
  color: #f2f6fa;
}

#btn_estop {
  background: qlineargradient(x1: 0.0, y1: 0.0, x2: 0.0, y2: 1.0, stop: 0.0 rgba(220, 40, 40, 100%), stop: 1.0 rgba(100, 40, 40, 100%));
  border: 4px solid red;
  border-radius: 16px;
  color: white;
}

#btn_estop:checked {
  background: qlineargradient(x1: 0.0, y1: 0.0, x2: 0.0, y2: 1.0, stop: 0.0 rgba(100, 40, 40, 100%), stop: 1.0 rgba(220, 40, 40, 100%));
}

#action_machine_on {
  background: transparent;
  border: none;
}

#action_spindle_fwd {
  qproperty-spindle_up_action: true;
}

#action_spindle_rev {
  qproperty-spindle_down_action: true;
}

/** Radio buttons **/
QRadioButton {
  spacing: 10px;
  margin-bottom: 2px;
  font: 10pt "Lato Heavy";
  color: #F0F0F0;
}

QRadioButton:disabled {
  color: gray;
}

QRadioButton::indicator {
  width: 20px;
  height: 20px;
}

QRadioButton::indicator:unchecked {
  image: none;
}

QRadioButton::indicator:checked {
  image: url(vyraxis/style_rc/checked.png);
}

/** Scrollbars **/
QScrollBar:vertical   { background: #0c1016; width: 30px;  margin: 0; border: none; }
QScrollBar:horizontal { background: #0c1016; height: 30px; margin: 0; border: none; }
QScrollBar::handle:vertical   { background: #2e3947; min-height: 30px; border-radius: 4px; margin: 2px; }
QScrollBar::handle:horizontal { background: #2e3947; min-width: 30px;  border-radius: 4px; margin: 2px; }
QScrollBar::handle:hover   { background: #4b5c70; }
QScrollBar::handle:pressed { background: #5b86a8; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; background: none; border: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QAbstractScrollArea::corner { background: #0c1016; }
QScrollBar::add-line:horizontal {
  background: transparent;
  subcontrol-position: right;
  subcontrol-origin: margin;
  width: 30px;
  image: url("vyraxis/style_rc/arrow_right.png");
}

/** Sliders **/
QSlider::groove:horizontal {
  height: 4px;
  background: #0c1016;
  border: 1px solid #2b3644;
  border-radius: 2px;
}

QSlider::handle:horizontal {
  background: qradialgradient(cx:0.4, cy:0.35, radius:0.8, fx:0.4, fy:0.35, stop:0 #b3d0e6, stop:1 #4f7a9c);
  width: 14px;
  height: 14px;
  margin: -6px 0;
  border: 1px solid #9cc0dc;
  border-radius: 2px;
  margin-top: -9px;
  margin-bottom: -9px;
}

QSlider::sub-page:horizontal {
  border-radius: 2px;
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #35546f, stop:1 #7fa6c4);
}

QSlider::groove:vertical {
  width: 4px;
  border-radius: 2px;
  background: #0c1016;
  border: 1px solid #2b3644;
}

QSlider::handle:vertical {
  background: qradialgradient(cx:0.4, cy:0.35, radius:0.8, fx:0.4, fy:0.35, stop:0 #b3d0e6, stop:1 #4f7a9c);
  width: 14px;
  height: 14px;
  margin: 0 -6px;
  border-radius: 2px;
  border: 1px solid #9cc0dc;
  margin-left: -9px;
  margin-right: -9px;
}

QSlider::add-page:vertical {
  border-radius: 2px;
  background: qlineargradient(x1:0, y1:1, x2:0, y2:0, stop:0 #35546f, stop:1 #7fa6c4);
}

QHeaderView {
  background-color: #404040;
  margin: 0px;
  padding: 0px;
  font: 14px "Lato Heavy";
}

QHeaderView::section {
  background-color: #404040;
  color: #F0F0F0;
  padding: 5px;
}

QHeaderView::section::vertical {
  border-top: 1px solid black;
  color: #8cc1e6;
}

QHeaderView::section::vertical {
  border-top: transparent;
}

QHeaderView::section::horizontal {
  border-left: 1px solid #e0e0e0;
  color: #8cc1e6;
}

QHeaderView::section::horizontal {
  border-left: transparent;
}

/** Tab Widgets **/
QTabWidget::pane {
    border: 1px solid #2b3644;
    border-radius: 3px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1a212b, stop:1 #151b23);
    top: 10px;
}

QTabBar { background: transparent; }
QTabBar::tab:disabled { color: #3d4858; }
QTabBar::tab:!selected { margin-top: 2px; }
QTabBar::tab {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2b3644, stop:1 #212a36);
  color: #c5cfdb;
  border: 1px solid #384555;
  border-radius: 3px;
  margin-right: 2px;
  min-height: 40px;
  min-width: 100px;
  font: 10pt "Lato Heavy";
}

/** Tool Tips **/
QToolTip {
  background: #0c1016;
  color: #c5cfdb;
  border: 1px solid #4b5c70;
  padding: 4px 8px;
}

/** GCode Viewer **/
EditorBase {
  qproperty-styleColorMarginBackground: #1b222c;
  qproperty-styleColorMarginText: #00aaff;  /* margin line numbers */
  qproperty-styleFontMargin: 10pt "Lato";
  qproperty-styleColorBackground: #1b222c;
  qproperty-styleColor0: #F0F0F0;  /* digit characters */
  qproperty-styleColor1: #00ff40;  /* comments */
  qproperty-styleColor2: #F0F0F0;  /* alphabetic characters */
  qproperty-styleColor3: #e0e0e0;  /* assignment characters */
  qproperty-styleColor4: #F0F0F0;  /* value characters */
  qproperty-styleColor5: #00e0e0;  /* axis characters */
  qproperty-styleColor6: #e0e0e0;  /* ? characters */
  qproperty-styleColor7: #00e0e0;  /* M and F characters */
  qproperty-styleFont0: 10pt "Lato";
  qproperty-styleFont1: 10pt "Lato";
  qproperty-styleFont2: 10pt "Lato";
  qproperty-styleFont3: 10pt "Lato";
  qproperty-styleFont4: 10pt "Lato";
  qproperty-styleFont5: 10pt "Lato";
  qproperty-styleFont6: 10pt "Lato";
  qproperty-styleFont7: 10pt "Lato";
  qproperty-styleColorSelectionBackground: #00aaff;  /* selection background */
}
